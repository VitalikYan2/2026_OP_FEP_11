#include <stdio.h>
#include <math.h>

int main(void) {
    double a, b, c, D;

    printf("Введіть a, b, c: ");
    scanf("%lf %lf %lf", &a, &b, &c);

    D = b*b - 4*a*c;

    if (D > 0)
        printf("x1 = %.2f, x2 = %.2f\n", (-b + sqrt(D)) / (2*a), (-b - sqrt(D)) / (2*a));
    else if (D == 0)
        printf("x = %.2f\n", -b / (2*a));
    else
        printf("Коренів немає\n");

    return 0;
}
