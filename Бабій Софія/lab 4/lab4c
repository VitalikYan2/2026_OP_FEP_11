#include <stdio.h>

void показ_двійкового(unsigned char число) {
    for (int і = 7; і >= 0; і--) {
        printf("%d", (число >> і) & 1);
    }
}

int main(void) {
    int a = 17, b = 5, c = 10;
    unsigned char x = 12, y = 10;

    printf("a = %d, b = %d\n\n", a, b);

   
    printf("--- Арифметичні ---\n");
    printf("a + b = %d\n", a + b);
    printf("a - b = %d\n", a - b);
    printf("a * b = %d\n", a * b);
    printf("a / b = %d\n", a / b);
    printf("a %% b = %d\n", a % b);
    printf("-a = %d\n", -a);
    printf("c++ дає %d\n", c++);
    printf("після цього c = %d\n", c);
    printf("--c дає %d\n", --c);

   
    printf("\n--- Порівняння (1 = так, 0 = ні) ---\n");
    printf("a > b: %d\n", a > b);
    printf("a < b: %d\n", a < b);
    printf("a >= b: %d\n", a >= b);
    printf("a <= b: %d\n", a <= b);
    printf("a == b: %d\n", a == b);
    printf("a != b: %d\n", a != b);

    
    printf("\n--- Логічні ---\n");
    printf("(a > b) && (b > 20): %d\n", (a > b) && (b > 20));
    printf("(a > b)  (b > 20): %d\n", (a > b)  (b > 20));
    printf("!(a > b): %d\n", !(a > b));

  
    printf("\n--- Побітові (у двійковому вигляді) ---\n");
    printf("x      = "); показ_двійкового(x);      printf("  (%d)\n", x);
    printf("y      = "); показ_двійкового(y);      printf("  (%d)\n", y);
    printf("x & y  = "); показ_двійкового(x & y);  printf("\n");
    printf("x | y  = "); показ_двійкового(x | y);  printf("\n");
    printf("x ^ y  = "); показ_двійкового(x ^ y);  printf("\n");
    printf("~x     = "); показ_двійкового(~x);     printf("\n");
    printf("x << 1 = "); показ_двійкового(x << 1); printf("\n");
    printf("x >> 2 = "); показ_двійкового(x >> 2); printf("\n");

    return 0;
}




