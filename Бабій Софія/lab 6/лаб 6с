#include <stdio.h>

int main(void) {
    int n;

    do {
        printf("Введіть N (від 7 до 12): ");
        scanf("%d", &n);
    } while (n < 7 || n > 12);

    double x, suma = 0.0, minimum, maximum;

    for (int i = 0; i < n; i++) {
        printf("Введіть число %d: ", i + 1);
        scanf("%lf", &x);

        suma += x;
        if (i == 0 || x < minimum) minimum = x;
        if (i == 0 || x > maximum) maximum = x;
    }

    printf("\nСума: %.2f\n", suma);
    printf("Середнє арифметичне: %.2f\n", suma / n);
    printf("Мінімальне: %.2f\n", minimum);
    printf("Максимальне: %.2f\n", maximum);

    return 0;
}

