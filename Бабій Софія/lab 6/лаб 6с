#include <stdio.h>

int main(void)
{
    char sentence[200];
    int vowels = 0;
    int consonants = 0;
    int i;

    printf("Введіть речення: ");
    fgets(sentence, 200, stdin);

    for (i = 0; sentence[i] != '\0'; i++) {
        char c = sentence[i];

        if (c >= 'A' && c <= 'Z') {
            c = c + 32;            
        }

        if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') {
            vowels++;
        } else if (c >= 'a' && c <= 'z') {
            consonants++;
        }
    }

    printf("Голосних: %d\n", vowels);
    printf("Приголосних: %d\n", consonants);

    return 0;
}




